# Leave everything blank to run in MOCK mode (fake PayPal + deterministic AI stub).

# --- Google Gemini (free key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: tried once if the primary model returns 404/503 after retries (e.g. gemini-2.5-flash)
GEMINI_FALLBACK_MODEL=
# AI runs in the background, so calls may take a while without blocking anyone (seconds)
# GEMINI_TIMEOUT=150
# GEMINI_TOTAL_BUDGET=330

# --- PayPal REST app, SANDBOX credentials (https://developer.paypal.com/dashboard/applications/sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com

# auto = mock only the parts whose keys are missing | mock = force mock everywhere
PROOFPAY_MODE=auto

# AI must be at least this confident (0-1) to release money automatically
APPROVAL_THRESHOLD=0.75

# Storage (defaults to ./data)
# DATABASE_PATH=./data/proofpay.db
# UPLOAD_DIR=./data/uploads
